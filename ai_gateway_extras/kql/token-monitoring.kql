// ============================================================================
// Token monitoring — tokens consumed through the APIM AI gateway.
//
// Source: the `llm-emit-token-metric` policy on the Azure OpenAI v1 API
// (namespace "ais-demo-ai-gateway", custom dimensions Subscription + Department).
// The policy emits one metric, `azure.ai_gateway.client.token.usage`, with the
// token category in the `gen_ai.token.type` dimension: total_tokens,
// input_tokens, output_tokens, output_tokens_details.reasoning_tokens,
// input_tokens_details.cached_tokens, ... (Chat Completions calls may report
// prompt_tokens / completion_tokens instead). Requires custom metrics with
// dimensions on the API's Application Insights diagnostic (infra/modules/apim.bicep).
//
// Run in: Log Analytics (workspace-based Application Insights, `AppMetrics`).
// For Application Insights › Logs, use the `customMetrics` variant at the bottom.
// ============================================================================

// --- Tokens per hour, split by token type and department --------------------
AppMetrics
| where Name == "azure.ai_gateway.client.token.usage"
| extend TokenType    = tostring(Properties["gen_ai.token.type"]),
         Subscription = tostring(Properties["Subscription"]),
         Department   = tostring(Properties["Department"])
| summarize Tokens = sum(Sum) by bin(TimeGenerated, 1h), TokenType, Department
| render timechart

// --- Top consumers over the last 24h ----------------------------------------
// AppMetrics
// | where TimeGenerated > ago(24h)
// | where Name == "azure.ai_gateway.client.token.usage"
// | where tostring(Properties["gen_ai.token.type"]) == "total_tokens"
// | extend Subscription = tostring(Properties["Subscription"]),
//          Department   = tostring(Properties["Department"])
// | summarize TotalTokens = sum(Sum) by Subscription, Department
// | top 10 by TotalTokens desc

// --- Application Insights › Logs (customMetrics) equivalent ------------------
// customMetrics
// | where name == "azure.ai_gateway.client.token.usage"
// | extend TokenType  = tostring(customDimensions["gen_ai.token.type"]),
//          Department = tostring(customDimensions["Department"])
// | summarize Tokens = sum(valueSum) by bin(timestamp, 1h), TokenType, Department
// | render timechart
