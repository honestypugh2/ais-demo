{
  "definition": {
    "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
      "serviceBusNamespace": {
        "type": "String",
        "metadata": {
          "description": "Service Bus namespace name (without .servicebus.windows.net)."
        }
      },
      "permitsQueue": {
        "type": "String",
        "defaultValue": "permits-in",
        "metadata": {
          "description": "Queue that the Service Bus-triggered Function listens on."
        }
      }
    },
    "triggers": {
      "When_a_permit_is_submitted": {
        "type": "Request",
        "kind": "Http",
        "inputs": {
          "schema": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "type": {
                "type": "string"
              },
              "parcel": {
                "type": "string"
              },
              "documentUrl": {
                "type": "string"
              },
              "applicantEmail": {
                "type": "string"
              }
            },
            "required": [
              "name",
              "type"
            ]
          }
        }
      }
    },
    "actions": {
      "Set_correlation_id": {
        "type": "Compose",
        "runAfter": {},
        "inputs": "@coalesce(triggerOutputs()?['headers']?['X-Correlation-Id'], guid())"
      },
      "Validate_payload": {
        "type": "If",
        "runAfter": {
          "Set_correlation_id": [
            "Succeeded"
          ]
        },
        "expression": {
          "and": [
            {
              "not": {
                "equals": [
                  "@coalesce(triggerBody()?['type'], '')",
                  ""
                ]
              }
            },
            {
              "not": {
                "equals": [
                  "@coalesce(triggerBody()?['name'], '')",
                  ""
                ]
              }
            }
          ]
        },
        "actions": {
          "Enrich_message": {
            "type": "Compose",
            "runAfter": {},
            "inputs": {
              "name": "@triggerBody()?['name']",
              "type": "@triggerBody()?['type']",
              "parcel": "@triggerBody()?['parcel']",
              "documentUrl": "@triggerBody()?['documentUrl']",
              "applicantEmail": "@triggerBody()?['applicantEmail']",
              "correlationId": "@outputs('Set_correlation_id')",
              "receivedAt": "@utcNow()"
            }
          },
          "Broker_properties": {
            "type": "Compose",
            "runAfter": {
              "Enrich_message": [
                "Succeeded"
              ]
            },
            "inputs": {
              "CorrelationId": "@{outputs('Set_correlation_id')}",
              "MessageId": "@{coalesce(triggerBody()?['parcel'], outputs('Set_correlation_id'))}"
            }
          },
          "Send_to_Service_Bus": {
            "type": "Http",
            "runAfter": {
              "Broker_properties": [
                "Succeeded"
              ]
            },
            "inputs": {
              "method": "POST",
              "uri": "https://@{parameters('serviceBusNamespace')}.servicebus.windows.net/@{parameters('permitsQueue')}/messages",
              "headers": {
                "Content-Type": "application/json",
                "BrokerProperties": "@{string(outputs('Broker_properties'))}"
              },
              "body": "@outputs('Enrich_message')",
              "authentication": {
                "type": "ManagedServiceIdentity",
                "audience": "https://servicebus.azure.net"
              }
            }
          },
          "Respond_202": {
            "type": "Response",
            "kind": "Http",
            "runAfter": {
              "Send_to_Service_Bus": [
                "Succeeded"
              ]
            },
            "inputs": {
              "statusCode": 202,
              "headers": {
                "Content-Type": "application/json",
                "X-Correlation-Id": "@{outputs('Set_correlation_id')}"
              },
              "body": {
                "status": "accepted",
                "via": "logic-app",
                "correlationId": "@{outputs('Set_correlation_id')}"
              }
            }
          }
        },
        "else": {
          "actions": {
            "Respond_400": {
              "type": "Response",
              "kind": "Http",
              "runAfter": {},
              "inputs": {
                "statusCode": 400,
                "headers": {
                  "Content-Type": "application/json",
                  "X-Correlation-Id": "@{outputs('Set_correlation_id')}"
                },
                "body": {
                  "error": "Missing required fields: name, type",
                  "correlationId": "@{outputs('Set_correlation_id')}"
                }
              }
            }
          }
        }
      }
    },
    "outputs": {}
  }
}
